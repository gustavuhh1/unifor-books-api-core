{
  "name": "unifor-books-api-core",
  "version": "1.0.0",
  "description": "O projeto consiste em um ecossistema digital para suprir a ausência de uma ferramenta portátil de conexão entre alunos e a biblioteca da UNIFOR. O sistema permite que estudantes consultem acervos, solicitem empréstimos, acompanhem devoluções e interajam com a comunidade de leitores, sem necessidade de presença física. Bibliotecários têm acesso a um painel administrativo integrado ao mesmo aplicativo mobile para moderação e gestão.",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsup src/server.ts --out-dir dist --format esm --clean",
    "seed": "prisma migrate reset --force && tsx prisma/seed.ts",
    "start": "node dist/server.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gustavuhh1/unifor-books-api-core.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/gustavuhh1/unifor-books-api-core/issues"
  },
  "homepage": "https://github.com/gustavuhh1/unifor-books-api-core#readme",
  "dependencies": {
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.8.0",
    "amqplib": "^1.0.3",
    "bcrypt": "^6.0.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.4",
    "jose": "^6.2.2",
    "pg": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^25.5.2",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "prisma": "^7.6.0",
    "supertest": "^7.2.2",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4",
    "vitest-mock-extended": "^4.0.0"
  }
}
